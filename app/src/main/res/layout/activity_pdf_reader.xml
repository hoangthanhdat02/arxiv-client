<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Top Navigation Toolbar with Zoom Actions -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?android:attr/colorBackground"
        android:elevation="4dp"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="PDF Reader"
        app:titleTextColor="?android:attr/textColorPrimary">

        <!-- Quick Zoom Actions for Touch & Emulator Mouse Controls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btn_zoom_out"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Zoom Out"
                android:src="@drawable/ic_zoom_out" />

            <ImageButton
                android:id="@+id/btn_zoom_reset"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Reset Zoom"
                android:src="@drawable/ic_zoom_reset" />

            <ImageButton
                android:id="@+id/btn_zoom_in"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Zoom In"
                android:src="@drawable/ic_zoom_in" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Paper Title & Page Info Sub-bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_bg"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tv_reader_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:text="Paper title..."
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_offline_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/badge_offline_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Offline Ready"
            android:textColor="@color/badge_offline_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Page 1/1"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main ViewPager2 for Native PDF Rendering -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager_pdf"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal" />

        <!-- Loading State Overlay -->
        <LinearLayout
            android:id="@+id/layout_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="visible">

            <ProgressBar
                android:id="@+id/pdf_progress_bar"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:id="@+id/tv_loading_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Loading PDF document..."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Error State Overlay (Offline or Network Error) -->
        <LinearLayout
            android:id="@+id/layout_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_error_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Cannot open PDF file.\nPlease check your network connection or open a downloaded paper offline."
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_retry"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary"
                app:cornerRadius="8dp"
                android:text="Retry" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Navigation Bar with Quick Page Jump & Offline Download Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <!-- Previous Page Button -->
        <ImageButton
            android:id="@+id/btn_prev_page"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous Page"
            android:src="@drawable/ic_navigate_before" />

        <!-- Quick Jump SeekBar -->
        <SeekBar
            android:id="@+id/seek_bar_pages"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1"
            android:progress="1" />

        <!-- Next Page Button -->
        <ImageButton
            android:id="@+id/btn_next_page"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next Page"
            android:src="@drawable/ic_navigate_next" />

        <!-- High-Contrast Material Save Offline Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_download_offline"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/button_primary_bg"
            android:textColor="@color/button_primary_text"
            android:text="Save Offline"
            android:textSize="12sp"
            android:textStyle="bold"
            app:icon="@drawable/ic_download"
            app:iconTint="@color/button_primary_text"
            app:iconSize="16dp"
            app:iconPadding="4dp"
            app:cornerRadius="20dp"
            android:paddingHorizontal="14dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />
    </LinearLayout>

</LinearLayout>
